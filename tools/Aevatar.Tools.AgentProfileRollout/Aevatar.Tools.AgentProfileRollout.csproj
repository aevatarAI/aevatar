<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Aevatar.Tools.AgentProfileRollout</AssemblyName>
    <RootNamespace>Aevatar.Tools.AgentProfileRollout</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Aevatar.AI.Core\Aevatar.AI.Core.csproj" />
    <ProjectReference Include="..\..\src\Aevatar.AI.ToolProviders.NyxId\Aevatar.AI.ToolProviders.NyxId.csproj" />
    <ProjectReference Include="..\..\src\Aevatar.AI.ToolProviders.Ornn\Aevatar.AI.ToolProviders.Ornn.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="protos\agent_profile_rollout_tool.proto"
              GrpcServices="None"
              AdditionalImportDirs="..\..\src\Aevatar.AI.Abstractions;..\..\src\Aevatar.Foundation.Abstractions;..\..\src\Aevatar.Foundation.VoicePresence.Abstractions" />
    <None Update="protos\agent_profile_rollout_tool.proto" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Aevatar.AI.Abstractions\ai_messages.proto"
          Link="protos\ai_messages.proto"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Aevatar.Foundation.Abstractions\Credentials\credential_secret_references.proto"
          Link="protos\Credentials\credential_secret_references.proto"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Aevatar.Foundation.Abstractions\Tools\tool_presentation.proto"
          Link="protos\Tools\tool_presentation.proto"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Aevatar.Foundation.VoicePresence.Abstractions\Protos\voice_presence.proto"
          Link="protos\Protos\voice_presence.proto"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="IncludeAgentProfileRolloutProtoc"
          BeforeTargets="_GetCopyToOutputDirectoryItemsFromThisProject"
          DependsOnTargets="Protobuf_ResolvePlatform">
    <ItemGroup>
      <_AgentProfileRolloutProtoc Include="$(Protobuf_PackagedToolsPath)/$(Protobuf_ToolsOs)_$(Protobuf_ToolsCpu)/protoc"
                                  Condition="'$(Protobuf_ToolsOs)' != 'windows'" />
      <_AgentProfileRolloutProtoc Include="$(Protobuf_PackagedToolsPath)\$(Protobuf_ToolsOs)_$(Protobuf_ToolsCpu)\protoc.exe"
                                  Condition="'$(Protobuf_ToolsOs)' == 'windows'" />
      <_AgentProfileRolloutStandardProto Include="$(Protobuf_StandardImportsPath)/google/protobuf/**/*.proto" />
      <ContentWithTargetPath Include="@(_AgentProfileRolloutProtoc)"
                             TargetPath="$([System.IO.Path]::GetFileName('%(_AgentProfileRolloutProtoc.Identity)'))"
                             CopyToOutputDirectory="PreserveNewest"
                             CopyToPublishDirectory="PreserveNewest" />
      <ContentWithTargetPath Include="@(_AgentProfileRolloutStandardProto)"
                             TargetPath="protos/google/protobuf/%(_AgentProfileRolloutStandardProto.RecursiveDir)%(_AgentProfileRolloutStandardProto.Filename)%(_AgentProfileRolloutStandardProto.Extension)"
                             CopyToOutputDirectory="PreserveNewest"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
