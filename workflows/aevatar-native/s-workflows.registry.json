{
  "schemaVersion": "aevatar.native.workflow.registry.v1",
  "runtime": {
    "owner": "aevatar",
    "workflowRuntime": "aevatar-workflow",
    "ingressOwner": "nyxid",
    "skillDiscoveryOwner": "ornn",
    "disallowedRuntimes": [
      "n8n"
    ]
  },
  "connectorCatalog": "connectors/aevatar-native-s-workflows.connectors.json",
  "workflows": [
    {
      "name": "budget-monitoring",
      "level": "S",
      "workflowFile": "s-workflows/budget-monitoring.yaml",
      "nyxidIngress": {
        "kind": "schedule_or_endpoint",
        "route": "budget-monitoring",
        "method": "POST",
        "target": {
          "kind": "aevatar_workflow_run",
          "workflow": "budget-monitoring",
          "callbackUrlEnv": "AEVATAR_WORKFLOW_CALLBACK_URL"
        }
      },
      "nyxidConnectors": [
        "nyxid_lark_bitable_proxy",
        "nyxid_lark_channel_bot"
      ],
      "payloadBuilder": {
        "kind": "ornn_skill_binding",
        "tool": "use_skill",
        "skill": "budget-monitoring.variance-payload-builder",
        "contract": {
          "inputRef": "budget-monitoring/budget-variance-payload.input.v1",
          "outputRef": "budget-monitoring/budget-variance-payload.output.v1"
        }
      },
      "ornnSkillBindings": [
        {
          "stepId": "load_budget_variance_skill",
          "skill": "budget-monitoring.variance-payload-builder",
          "tool": "use_skill",
          "purpose": "payload_construction"
        },
        {
          "stepId": "build_variance_payload",
          "skill": "budget-monitoring.variance-payload-builder",
          "purpose": "payload_construction"
        }
      ],
      "runtimeAssertions": {
        "aevatarOwnsState": true,
        "nyxidOwnsIngressAndCredentials": true,
        "ornnOwnsSkillDiscovery": true,
        "dependsOnExternalRuntime": false
      }
    },
    {
      "name": "lark-onboarding-email-approval",
      "level": "S",
      "workflowFile": "s-workflows/lark-onboarding-email-approval.yaml",
      "nyxidIngress": {
        "kind": "endpoint",
        "route": "lark-onboarding-email-approval",
        "method": "POST",
        "target": {
          "kind": "aevatar_workflow_run",
          "workflow": "lark-onboarding-email-approval",
          "callbackUrlEnv": "AEVATAR_WORKFLOW_CALLBACK_URL"
        }
      },
      "nyxidConnectors": [
        "nyxid_lark_approval_proxy"
      ],
      "payloadBuilder": {
        "kind": "ornn_skill_binding",
        "tool": "use_skill",
        "skill": "lark-onboarding-email-approval.payload-builder",
        "contract": {
          "inputRef": "lark-onboarding-email-approval/lark-approval-payload.input.v1",
          "outputRef": "lark-onboarding-email-approval/lark-approval-payload.output.v1"
        }
      },
      "ornnSkillBindings": [
        {
          "stepId": "load_onboarding_payload_skill",
          "skill": "lark-onboarding-email-approval.payload-builder",
          "tool": "use_skill",
          "purpose": "payload_construction"
        },
        {
          "stepId": "build_lark_approval_payload",
          "skill": "lark-onboarding-email-approval.payload-builder",
          "purpose": "payload_construction"
        }
      ],
      "runtimeAssertions": {
        "aevatarOwnsState": true,
        "nyxidOwnsIngressAndCredentials": true,
        "ornnOwnsSkillDiscovery": true,
        "dependsOnExternalRuntime": false
      }
    }
  ]
}
