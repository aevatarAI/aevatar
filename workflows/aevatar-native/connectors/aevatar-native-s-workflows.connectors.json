{
  "connectors": {
    "nyxid_lark_bitable_proxy": {
      "type": "http",
      "enabled": true,
      "timeoutMs": 45000,
      "retry": 1,
      "http": {
        "baseUrl": "${NYXID_PROXY_BASE_URL}/api/v1/proxy/s/${NYXID_LARK_BITABLE_SERVICE_SLUG}",
        "allowedMethods": [
          "GET",
          "POST"
        ],
        "allowedPaths": [
          "/open-apis/bitable/v1/apps/*"
        ],
        "defaultHeaders": {
          "Content-Type": "application/json"
        }
      }
    },
    "nyxid_lark_approval_proxy": {
      "type": "http",
      "enabled": true,
      "timeoutMs": 60000,
      "retry": 1,
      "http": {
        "baseUrl": "${NYXID_PROXY_BASE_URL}/api/v1/proxy/s/${NYXID_LARK_APPROVAL_SERVICE_SLUG}",
        "allowedMethods": [
          "POST"
        ],
        "allowedPaths": [
          "/open-apis/approval/v4/instances"
        ],
        "defaultHeaders": {
          "Content-Type": "application/json"
        }
      }
    },
    "nyxid_lark_channel_bot": {
      "type": "http",
      "enabled": true,
      "timeoutMs": 30000,
      "retry": 1,
      "http": {
        "baseUrl": "${NYXID_PROXY_BASE_URL}/api/v1/proxy/s/${NYXID_LARK_BOT_SERVICE_SLUG}",
        "allowedMethods": [
          "POST"
        ],
        "allowedPaths": [
          "/open-apis/bot/v2/hook/*"
        ],
        "defaultHeaders": {
          "Content-Type": "application/json"
        }
      }
    },
    "aevatar_native_payload_builder": {
      "type": "http",
      "enabled": true,
      "timeoutMs": 30000,
      "retry": 0,
      "http": {
        "baseUrl": "${AEVATAR_NATIVE_PAYLOAD_BUILDER_BASE_URL}",
        "allowedMethods": [
          "POST"
        ],
        "allowedPaths": [
          "/workflow-payloads/budget-monitoring/variance",
          "/workflow-payloads/lark-onboarding-email-approval/approval-instance"
        ],
        "allowedInputKeys": [
          "workflow",
          "run_id",
          "ingress_event",
          "records",
          "skill_binding"
        ],
        "defaultHeaders": {
          "Content-Type": "application/json"
        }
      }
    }
  }
}
