# ChatGPT product reasoning defaults to browser-login mode.
CHATGPT_CHANNEL=browser

# Optional API fallback. Leave empty when using the ChatGPT website.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.4

GOOGLE_CLOUD_ACCOUNT=
GOOGLE_CLOUD_PROJECT=
GCLOUD_BIN=gcloud
CLOUDSDK_PYTHON=

# Optional override. Leave empty to use the current Google Cloud login.
STITCH_ACCESS_TOKEN=
