    <Content Include="..\..\..\workflow-templates\**\*.yaml" Link="workflow-templates\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
