{
  "Aevatar": {
    "Authentication": {
      "Enabled": true,
      "Authority": "https://nyx.chrono-ai.fun",
      "Audience": "https://nyx-api.chrono-ai.fun",
      "RequireHttpsMetadata": true,
      "NyxIdIdentityAssertion": {
        "OidcDiscoveryUrl": "https://nyx-api.chrono-ai.fun/.well-known/openid-configuration",
        "Issuer": "https://nyx-api.chrono-ai.fun",
        "ExpectedAudience": "urn:aevatar:api",
        "ClockSkewSeconds": 30,
        "MaximumLifetimeSeconds": 60
      }
    },
    "NyxId": {
      "Authority": "https://nyx.chrono-ai.fun",
      "ApiBaseUrl": "https://nyx-api.chrono-ai.fun",
      "GatewayEndpoint": "https://nyx.chrono-ai.fun/api/v1/llm/gateway/v1",
      "ChronoLlmEndpoint": "https://llm.aelf.dev/v1",
      "SandboxServiceSlug": "chrono-sandbox",
      "AdditionalRequiredServiceSlugs": [],
      "Relay": {
        "EnableDebugDiagnostics": true
      },
      "AssistantActions": {
        "Enabled": true
      }
    },
    "CodexExecution": {
      "ManagedSandbox": {
        "Enabled": false,
        "RolloutBoundary": "Unspecified",
        "Eligibility": {
          "Mode": "Allowlist",
          "AllowedNyxIdUserIds": []
        },
        "CredentialLifetimeDays": 30,
        "MaxResponseBytes": 1048576
      }
    },
    "BackendConsole": {
      "OidcAuthority": "",
      "OidcClientId": "37a93189-2734-406e-bca1-7dbdf25c5a53",
      "OidcScope": "openid profile email proxy",
      "NyxApiBaseUrl": "",
      "StorageKey": "aevatar-console:nyxid:pkce",
      "DefaultReturnPath": "/admin"
    },
    "Ornn": {
      "NyxIdSlug": "ornn-api"
    },
    "SystemSkills": {
      "Enabled": false,
      "SetName": "aevatar-system",
      "RefreshTtl": "00:15:00",
      "MaxSkills": 32,
      "MaxBytes": 32768
    },
    "Responses": {
      "ModelMetadataFallbacks": {
        "deepseek": {
          "ContextLength": 64000,
          "MaxOutputTokens": 8192
        },
        "llm-deepseek": {
          "ContextLength": 64000,
          "MaxOutputTokens": 8192
        }
      }
    },
    "VoicePresence": {
      "OpenAI": {
        "Model": "gpt-realtime",
        "Voice": "alloy",
        "Instructions": "你是一个简短自然的语音助手。"
      }
    },
    "Status": {
      "DefaultIntervalSeconds": 60,
      "DefaultTimeoutMs": 5000,
      "SelfBaseUrl": "http://localhost:5080",
      "UseBuiltInTargets": true
    }
  },
  "Ornn": {
    "BaseUrl": "https://ornn.chrono-ai.fun"
  },
  "Cli": {
    "App": {
      "Connectors": {
        "ChronoStorage": {
          "Enabled": true,
          "UseNyxProxy": true,
          "NyxProxyBaseUrl": "https://nyx.chrono-ai.fun",
          "NyxProxyServiceSlug": "chrono-storage-service",
          "BaseUrl": "http://chrono-storage.chronoai-platform.svc.cluster.local:3805",
          "Bucket": "chrono-platform-aevatar-studio"
        }
      }
    }
  },
  "Studio": {
    "Storage": {
      "DefaultLocalRuntimeBaseUrl": "http://127.0.0.1:5080",
      "DefaultRemoteRuntimeBaseUrl": "https://aevatar-console-backend-api.aevatar.ai"
    }
  }
}
