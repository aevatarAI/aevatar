{
  "Aevatar": {
    "Authentication": {
      "Enabled": true,
      "Authority": "https://nyx-api.chrono-ai.fun",
      "RequireHttpsMetadata": true
    },
    "NyxId": {
      "Authority": "https://nyx-api.chrono-ai.fun",
      "GatewayEndpoint": "https://nyx-api.chrono-ai.fun/api/v1/llm/gateway/v1",
      "ChronoLlmEndpoint": "https://llm.aelf.dev/v1",
      "Relay": {
        "EnableDebugDiagnostics": true,
        "ResponseTimeoutSeconds": 300
      }
    },
    "Ornn": {
      "NyxIdSlug": "ornn-api"
    },
    "Responses": {
      "ModelMetadataFallbacks": {
        "deepseek": {
          "ContextLength": 64000,
          "MaxOutputTokens": 8192
        },
        "llm-deepseek": {
          "ContextLength": 64000,
          "MaxOutputTokens": 8192
        }
      }
    },
    "VoicePresence": {
      "OpenAI": {
        "Endpoint": "https://nyx.chrono-ai.fun/api/v1/proxy/s/llm-openai",
        "Model": "gpt-realtime",
        "Voice": "alloy",
        "Instructions": "你是一个简短自然的语音助手。"
      }
    },
    "Status": {
      "DefaultIntervalSeconds": 60,
      "DefaultTimeoutMs": 5000,
      "Targets": [
        {
          "Slug": "self-liveness",
          "Name": "HTTP API (liveness)",
          "Category": "self",
          "Probe": "http_status",
          "IntervalSeconds": 30,
          "Parameters": {
            "Url": "http://127.0.0.1:5080/health/live"
          }
        },
        {
          "Slug": "self-readiness",
          "Name": "HTTP API (readiness)",
          "Category": "self",
          "Probe": "http_status",
          "IntervalSeconds": 30,
          "Parameters": {
            "Url": "http://127.0.0.1:5080/health/ready",
            "ExpectedStatuses": "200",
            "DegradedOnNon2xx": "true"
          }
        },
        {
          "Slug": "nyxid-llm-catalog",
          "Name": "NyxID LLM Catalog",
          "Category": "upstream",
          "Probe": "http_status",
          "IntervalSeconds": 60,
          "Parameters": {
            "Url": "${configuration:Aevatar:NyxId:Authority}/api/v1/llm/services",
            "ExpectedStatuses": "200,401"
          }
        },
        {
          "Slug": "elasticsearch",
          "Name": "Elasticsearch",
          "Category": "upstream",
          "Probe": "http_status",
          "IntervalSeconds": 60,
          "Parameters": {
            "Url": "${configuration:Projection:Document:Providers:Elasticsearch:Endpoints:0}/_cluster/health",
            "ExpectedStatuses": "200"
          }
        },
        {
          "Slug": "channel-bot-runtime",
          "Name": "Channel Bot Registrations",
          "Category": "feature",
          "Probe": "readmodel_freshness",
          "IntervalSeconds": 60,
          "Parameters": {
            "Source": "channel-bot-registrations",
            "MinCount": "0"
          }
        },
        {
          "Slug": "llm-openai-dry-run",
          "Name": "LLM Dry-Run (OpenAI via NyxID)",
          "Category": "feature",
          "Probe": "http_status",
          "IntervalSeconds": 300,
          "TimeoutMs": 15000,
          "Enabled": false,
          "Parameters": {
            "Method": "POST",
            "Url": "${configuration:Aevatar:NyxId:Authority}/api/v1/proxy/s/llm-openai/v1/chat/completions",
            "Header.Authorization": "Bearer ${configuration:Aevatar:Status:NyxIdProbeToken}",
            "ContentType": "application/json",
            "Body": "{\"model\":\"gpt-4o-mini\",\"messages\":[{\"role\":\"user\",\"content\":\"ping\"}],\"max_tokens\":1}"
          }
        }
      ]
    }
  },
  "Ornn": {
    "BaseUrl": "https://ornn.chrono-ai.fun"
  },
  "Cli": {
    "App": {
      "Connectors": {
        "ChronoStorage": {
          "Enabled": true,
          "UseNyxProxy": true,
          "NyxProxyBaseUrl": "https://nyx-api.chrono-ai.fun",
          "NyxProxyServiceSlug": "chrono-storage-service",
          "BaseUrl": "http://chrono-storage.chronoai-platform.svc.cluster.local:3805",
          "Bucket": "chrono-platform-aevatar-studio"
        }
      }
    }
  },
  "Studio": {
    "Storage": {
      "DefaultLocalRuntimeBaseUrl": "http://127.0.0.1:5080",
      "DefaultRemoteRuntimeBaseUrl": "https://aevatar-console-backend-api.aevatar.ai"
    }
  }
}
