{
  "Aevatar": {
    "Authentication": {
      "Enabled": true,
      "Authority": "https://nyx-api.chrono-ai.fun",
      "Audience": "https://nyx-api.chrono-ai.fun",
      "RequireHttpsMetadata": true,
      "NyxIdIdentityAssertion": {
        "OidcDiscoveryUrl": "https://nyx-api.chrono-ai.fun/.well-known/openid-configuration",
        "Issuer": "https://nyx-api.chrono-ai.fun",
        "ExpectedAudience": "urn:aevatar:api",
        "ClockSkewSeconds": 30,
        "MaximumLifetimeSeconds": 60
      }
    },
    "NyxId": {
      "Authority": "https://nyx-api.chrono-ai.fun",
      "ApiBaseUrl": "https://nyx-api.chrono-ai.fun",
      "GatewayEndpoint": "https://nyx-api.chrono-ai.fun/api/v1/llm/gateway/v1",
      "ChronoLlmEndpoint": "https://llm.aelf.dev/v1",
      "AdditionalRequiredServiceSlugs": [],
      "Relay": {
        "EnableDebugDiagnostics": true
      },
      "AssistantActions": {
        "Enabled": true
      }
    },
    "CodexExecution": {
      "ManagedSandbox": {
        "Enabled": false,
        "RolloutBoundary": "Unspecified",
        "Eligibility": {
          "Mode": "Allowlist",
          "AllowedNyxIdUserIds": []
        },
        "CredentialLifetimeDays": 30,
        "MaxResponseBytes": 1048576
      }
    },
    "BackendConsole": {
      "OidcAuthority": "https://nyx-api.chrono-ai.fun",
      "OidcClientId": "a6ff2946-f02f-4c35-8203-1ec46132b660",
      "OidcScope": "openid profile email offline_access proxy",
      "NyxApiBaseUrl": "https://nyx-api.chrono-ai.fun",
      "StorageKey": "aevatar-console:nyxid:pkce",
      "DefaultReturnPath": "/admin",
      "EnableStudioWireInspector": false
    },
    "Delivery": {
      "PackageDirectory": "workflow-delivery-packages",
      "DefaultExpiryHours": 168,
      "MaximumExpiryHours": 720
    },
    "Ornn": {
      "NyxIdSlug": "ornn-api"
    },
    "Web": {
      "NyxIdSearchSlug": "tavily-search"
    },
    "SystemSkills": {
      "Enabled": false,
      "SetName": "aevatar-system",
      "RefreshTtl": "00:15:00",
      "MaxSkills": 32,
      "MaxBytes": 32768
    },
    "Responses": {
      "ModelMetadataFallbacks": {
        "deepseek": {
          "ContextLength": 64000,
          "MaxOutputTokens": 8192
        },
        "llm-deepseek": {
          "ContextLength": 64000,
          "MaxOutputTokens": 8192
        }
      }
    },
    "VoicePresence": {
      "OpenAI": {
        "Model": "gpt-realtime",
        "Voice": "alloy",
        "Instructions": "你是一个简短自然的语音助手。"
      }
    },
    "Status": {
      "DefaultIntervalSeconds": 60,
      "DefaultTimeoutMs": 5000,
      "SelfBaseUrl": "http://localhost:5080",
      "UseBuiltInTargets": true
    }
  },
  "Ornn": {
    "BaseUrl": "https://ornn.chrono-ai.fun"
  },
  "ScopeWorkflowServices": {
    "ConfiguredTemplates": [
      {
        "WorkflowId": "dinner_date",
        "RevisionId": "dinner-date-mock-v2",
        "WorkflowYamlPath": "workflow-templates/dinner_date_mock.yaml",
        "WorkflowName": "dinner_date_mock",
        "DisplayName": "Dinner Date Mock"
      }
    ]
  },
  "AgentProfiles": {
    "SystemDefaultNyxIdChat": {
      "Enabled": true,
      "ProfileSlug": "nyxid-chat-default",
      "DisplayName": "NyxID Chat Default",
      "Purpose": "Default public NyxID chat surface with managed workflow execution.",
      "Instructions": "Help users through ordinary chat. When the user asks to book or plan a dinner reservation, first use any available current-user read-only profile, preference, or context tool to recover saved dining details, then collect only the missing date, time, party size, location, cuisines, budget, and contact details. Use the configured managed workflow directly when enough booking details are available. The exact configured workflow_id is dinner_date; do not use policy revision ids, template revision ids, display names, or workflow names as workflow_id. Start dinner_date with aevatar_start_workflow using inputs.prompt as a serialized JSON string containing task_id, raw_user_request, participant, window, party_size, day, time, location, cuisines, restaurant_type, phone_number, budget_cap, policy, search_query, missing_fields, preference_context_merged, and preference_context_source_tools. If a read-only profile, preference, or context tool result was used to fill or confirm any workflow input, set preference_context_merged to true and list only the opaque source tool names in preference_context_source_tools; do not copy raw preference text into those evidence fields. If required booking details are still missing, ask once for the missing fields before starting dinner_date.",
      "PolicyRevision": "nyxid-chat-managed-workflow-v2",
      "MaximumToolPolicy": {
        "ToolNames": [
          "ask_user",
          "aevatar_start_workflow",
          "aevatar_observe_run",
          "aevatar_read_workflow_run_artifact"
        ],
        "ConnectedServiceSelectors": [
          {
            "AllowedRisks": [
              "read_only"
            ]
          }
        ]
      },
      "RecoveryToolPolicy": {
        "ToolNames": [
          "ask_user",
          "aevatar_observe_run",
          "aevatar_read_workflow_run_artifact"
        ]
      },
      "Members": []
    }
  },
  "Cli": {
    "App": {
      "Connectors": {
        "ChronoStorage": {
          "Enabled": true,
          "UseNyxProxy": true,
          "NyxProxyBaseUrl": "https://nyx-api.chrono-ai.fun",
          "NyxProxyServiceSlug": "chrono-storage-service",
          "BaseUrl": "http://chrono-storage.chronoai-platform.svc.cluster.local:3805",
          "Bucket": "chrono-platform-aevatar-studio"
        }
      }
    }
  },
  "Studio": {
    "Storage": {
      "DefaultLocalRuntimeBaseUrl": "http://127.0.0.1:5080",
      "DefaultRemoteRuntimeBaseUrl": "https://aevatar-console-backend-api.aevatar.ai"
    }
  }
}
